# Linux cloud server deployment example
# Copy this file to the repository root as .env on the server, then replace every placeholder.

# ============ Service ============
HOST=0.0.0.0
PORT=8900
FRONTEND_PORT=3100
BACKEND_PORT=8900
DOCS_PORT=3101
POSTGRES_PORT=54322

# Use your real origins. For HTTPS public testing, keep only https:// entries.
CORS_ALLOW_ORIGINS=https://vinote.example.com

# ============ App Auth ============
APP_JWT_SECRET=replace-with-a-strong-random-secret
ACCESS_TOKEN_EXPIRE_SECONDS=604800
AUTH_COOKIE_NAME=vinote_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
SHARE_BASE_URL=https://vinote.example.com

# ============ External API ============
# Optional admin fallback key for /api/v1/* endpoints. Normal users can create their own keys after login.
EXTERNAL_API_KEY=
EXTERNAL_API_USER_ID=

# ============ Database ============
POSTGRES_DB=vinote
POSTGRES_USER=vinote
POSTGRES_PASSWORD=replace-with-a-strong-random-db-password
DATABASE_URL=postgresql+psycopg://vinote:replace-with-a-strong-random-db-password@postgres:5432/vinote

# ============ LLM ============
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-your-api-key

# ============ Model/STT Profile Security ============
MODEL_PROFILE_ENCRYPTION_KEY=replace-with-a-long-random-encryption-secret
AZURE_OPENAI_API_VERSION=2024-10-21

# ============ Transcriber ============
# For a simple cloud test, Groq is the lightest operational path.
TRANSCRIBER_TYPE=groq
GROQ_API_KEY=gsk_your-groq-api-key

# ============ Storage ============
DATA_DIR=data
OUTPUT_DIR=output

# ============ Frontend Runtime ============
# Leave empty when the frontend and /api share the same public origin through the reverse proxy.
VITE_API_BASE_URL=
VITE_DOCS_BASE_URL=
