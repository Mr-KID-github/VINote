# ============ Service ============
HOST=0.0.0.0
PORT=8900
CORS_ALLOW_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
BACKEND_PORT=8900
FRONTEND_PORT=3100
POSTGRES_PORT=54322

# ============ App Auth ============
APP_JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_SECONDS=604800
AUTH_COOKIE_NAME=vinote_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
SHARE_BASE_URL=

# ============ Database ============
POSTGRES_DB=vinote
POSTGRES_USER=vinote
POSTGRES_PASSWORD=change-me-to-a-long-random-db-password
DATABASE_URL=postgresql+psycopg://vinote:change-me-to-a-long-random-db-password@127.0.0.1:54322/vinote

# ============ VILab Server ============
VILAB_SERVER_BASE_URL=http://127.0.0.1:9876
VILAB_SERVER_API_KEY=
VILAB_SERVER_CLIENT_ID=
VILAB_SERVER_DESKTOP_ID=
VILAB_SERVER_TIMEOUT_SECONDS=300
SECRET_ENCRYPTION_KEY=replace-with-a-long-random-secret

# ============ Storage ============
DATA_DIR=data
OUTPUT_DIR=output

# ============ Frontend Runtime ============
VITE_API_BASE_URL=
VITE_DOCS_BASE_URL=
DOCS_PORT=3101
