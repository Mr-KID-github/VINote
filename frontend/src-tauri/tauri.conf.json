{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VINote",
  "version": "0.2.0",
  "identifier": "app.vinote.desktop",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run web:build:tauri",
    "devUrl": "http://127.0.0.1:3100",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VINote",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity"
  }
}
